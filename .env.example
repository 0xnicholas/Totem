# Copy to .env and adjust. Values used by docker compose (compose.yaml) and
# the migration scripts.

POSTGRES_USER=totem
POSTGRES_PASSWORD=totem
POSTGRES_DB=totem
POSTGRES_PORT=5433

# Redis. 6380 by default: compose maps host REDIS_PORT → container 6379
# (6379 often clashes with a local Redis install on macOS).
REDIS_PORT=6380

# Used by `npm run migrate:up` / `npm run migrate:down` outside compose
# (compose builds its own value from the POSTGRES_* vars above).
DATABASE_URL=postgres://totem:totem@localhost:5433/totem

# Admin API. TOTEM_ADMIN_KEY guards every /admin route; the compose default
# is a dev placeholder — set a real key (e.g. from
# `totemctl create-key <tenant> --scope admin`) for anything real.
ADMIN_PORT=3000
TOTEM_ADMIN_KEY=tt_dev_admin_change_me

# Secret encryption at rest (ADR-0004, issue #15). Master key for the
# per-tenant derived keys that encrypt Feishu tokens and app secrets;
# required by the API server (>= 32 chars). Generate one:
#   openssl rand -hex 32
TOTEM_TOKEN_ENC_KEY=tt_dev_token_enc_change_me_0123456789

# OAuth flow. FEISHU_BASE_URL defaults to https://open.feishu.cn (point it
# at a mock for local testing). TOTEM_OAUTH_REDIRECT_URI is the optional
# canonical callback URL; oauth-start accepts a per-flow redirect URI too.
FEISHU_BASE_URL=https://open.feishu.cn
# TOTEM_OAUTH_REDIRECT_URI=https://totem.example.com/oauth/callback/feishu
